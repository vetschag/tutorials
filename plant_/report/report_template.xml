<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_plant_template_document">
        <t t-call="web.external_layout">
            <div class="page">

                <!-- ══════════════════════════════════════
                     INHALTSVERZEICHNIS
                ═══════════════════════════════════════ -->
                <h4 style="margin-bottom:12px;">Table of Contents</h4>
                <t t-set="block_num" t-value="0"/>
                <t t-foreach="doc.block_ids" t-as="block">
                    <t t-set="block_num" t-value="block_num + 1"/>
                    <div style="font-size:13px; font-weight:600; margin-top:6px;">
                        <t t-esc="block_num"/>. <t t-esc="block.name"/>
                    </div>
                    <t t-set="agg_num" t-value="0"/>
                    <t t-foreach="block.aggregate_ids" t-as="agg">
                        <t t-set="agg_num" t-value="agg_num + 1"/>
                        <div style="font-size:12px; margin-left:20px; color:#444;">
                            <t t-esc="block_num"/>.<t t-esc="agg_num"/>. <t t-esc="agg.name"/>
                        </div>
                    </t>
                </t>

                <!-- Seitenumbruch nach Inhaltsverzeichnis -->
                <div style="page-break-after:always;"/>

                <!-- ══════════════════════════════════════
                     INHALT — Block → Aggregat → Felder
                ═══════════════════════════════════════ -->
                <t t-set="block_num" t-value="0"/>
                <t t-foreach="doc.block_ids" t-as="block">
                    <t t-set="block_num" t-value="block_num + 1"/>

                    <!-- Block = Haupttitel (H1) -->
                    <h2 style="margin-top:0; margin-bottom:16px;
                               border-bottom:2px solid #222;
                               padding-bottom:6px;">
                        <t t-esc="block_num"/>. <t t-esc="block.name"/>
                    </h2>

                    <t t-set="agg_num" t-value="0"/>
                    <t t-foreach="block.aggregate_ids" t-as="agg">
                        <t t-set="agg_num" t-value="agg_num + 1"/>

                        <!-- Aggregat = Untertitel (H3) -->
                        <h3 style="margin-top:20px; margin-bottom:10px;
                                   border-bottom:1px solid #aaa;
                                   padding-bottom:4px;">
                            <t t-esc="block_num"/>.<t t-esc="agg_num"/>. <t t-esc="agg.name"/>
                        </h3>

                        <!-- Felder: Text + Selection als Bullet-Points -->
                        <t t-foreach="agg.type_ids" t-as="type">
                            <t t-foreach="type.field_ids" t-as="field">
                                <t t-if="field.field_type == 'text' and field.value_text">
                                    <ul style="margin:4px 0; padding-left:20px;">
                                        <li style="font-size:12px;">
                                            <strong><t t-esc="field.name"/>:</strong>
                                            <t t-esc="field.value_text"/>
                                        </li>
                                    </ul>
                                </t>
                                <t t-elif="field.field_type == 'selection' and field.value_selection">
                                    <ul style="margin:4px 0; padding-left:20px;">
                                        <li style="font-size:12px;">
                                            <strong><t t-esc="field.name"/>:</strong>
                                            <t t-esc="field.value_selection.name"/>
                                        </li>
                                    </ul>
                                </t>
                            </t>
                        </t>

                        <!-- Bilder am Schluss des Aggregats nebeneinander -->
                        <t t-set="has_images" t-value="False"/>
                        <t t-foreach="agg.type_ids" t-as="type">
                            <t t-foreach="type.field_ids" t-as="field">
                                <t t-if="field.field_type == 'image' and field.value_image">
                                    <t t-set="has_images" t-value="True"/>
                                </t>
                            </t>
                        </t>

                        <t t-if="has_images">
                            <div style="margin-top:12px; display:flex;
                                        flex-wrap:wrap; gap:8px;">
                                <t t-foreach="agg.type_ids" t-as="type">
                                    <t t-foreach="type.field_ids" t-as="field">
                                        <t t-if="field.field_type == 'image' and field.value_image">
                                            <img t-attf-src="data:image/png;base64,{{ field.value_image }}"
                                                 style="width:48%; max-width:48%;
                                                        object-fit:cover;
                                                        border-radius:4px;
                                                        border:1px solid #ddd;"/>
                                        </t>
                                    </t>
                                </t>
                            </div>
                        </t>

                        <!-- Seitenumbruch nach jedem Aggregat -->
                        <div style="page-break-after:always;"/>

                    </t>
                </t>

            </div>
        </t>
    </template>

    <template id="report_plant_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="plant.report_plant_template_document"
                   t-lang="doc.env.lang"/>
            </t>
        </t>
    </template>

</odoo>
